{
  "name": "@tailor-kit/ai-ui",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Shared AI UI: provider table, settings dialog (profiles, keys through the backend), \"what will be sent\" preview, Markdown rendering, dialog frame, extension AI client (source package, no build step).",
  "type": "module",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*.svelte": {
      "types": "./src/*.svelte",
      "svelte": "./src/*.svelte",
      "default": "./src/*.svelte"
    }
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailor-kit/ui": "0.0.0",
    "svelte": "^5.59.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
