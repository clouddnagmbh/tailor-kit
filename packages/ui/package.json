{
  "name": "@tailor-kit/ui",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Shared Svelte UI primitives, icons and design tokens (source package, no build step).",
  "type": "module",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./gallery": {
      "types": "./src/gallery/index.ts",
      "svelte": "./src/gallery/index.ts",
      "default": "./src/gallery/index.ts"
    },
    "./styles/*": "./src/styles/*",
    "./floating": {
      "types": "./src/floating.ts",
      "default": "./src/floating.ts"
    },
    "./position": {
      "types": "./src/position.ts",
      "default": "./src/position.ts"
    },
    "./*.svelte": {
      "types": "./src/*.svelte",
      "svelte": "./src/*.svelte",
      "default": "./src/*.svelte"
    }
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/svelte": "1.70.0",
    "svelte": "^5.59.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
